{
  "name": "campus-lazy-station",
  "version": "3.0.0",
  "description": "校园圈 - 模块化架构",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "safe": "node start-server.js",
    "safe:dev": "node start-server.js",
    "db:init": "node db-init.js",
    "db:reset": "node db-init.js",
    "pm2": "pm2",
    "pm2:start": "pm2 start server.js --name campus-lazy",
    "pm2:stop": "pm2 stop campus-lazy",
    "pm2:restart": "pm2 restart campus-lazy",
    "pm2:log": "pm2 log campus-lazy",
    "pm2:status": "pm2 list",
    "pm2:delete": "pm2 delete campus-lazy",
    "clean": "node -e \"const fs=require('fs'); ['lazy_station.db-wal','lazy_station.db-shm'].forEach(f=>fs.existsSync(f)&&fs.unlinkSync(f)); console.log('Cleaned');\""
  },
  "dependencies": {
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "iconv-lite": "^0.7.2",
    "multer": "^2.1.1",
    "playwright": "^1.61.0",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "acorn": "^8.16.0",
    "autocannon": "^8.0.0",
    "sharp": "^0.35.1"
  }
}
